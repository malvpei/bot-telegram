TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Zona horaria para /schedule. Los cambios de horario de verano se aplican
# automaticamente. Ejemplo: /schedule 6 08:00 18:00
BATCH_TIMEZONE=Europe/Madrid

# Carpeta persistente del bot: memoria de fotos usadas, cache, outputs y estado.
# En Docker/Coolify el Dockerfile y docker-compose la fuerzan a /app/data.
# En local puedes dejarlo vacio para usar ./data.
DATA_DIR=

INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Alternativa sin login: pega aquí las cookies de tu sesión de Instagram
# (desde el navegador donde tengas IG abierto: F12 -> Application ->
# Cookies -> instagram.com). Con esto el bot no pide usuario/contraseña
# y evita el 429 anónimo.
IG_SESSIONID=
IG_DS_USER_ID=
IG_CSRFTOKEN=
# Si tienes 2FA o quieres evitar logins repetidos, deja un session file de
# instaloader aquí (default: data/state/instagram_session/<usuario>).
INSTAGRAM_SESSION_PATH=

FIXED_IMAGE_PATH=

# Archivo con las cuentas de Instagram que el bot usará, una por línea.
# Default: bot-telegram/accounts.txt
ACCOUNTS_FILE=

# Archivo con las cuentas de mujeres, una por línea.
# Default: bot-telegram/accounts_women.txt
WOMEN_ACCOUNTS_FILE=

MAX_POSTS_PER_ACCOUNT=100
MAX_URLS_PER_JOB=8

# Pool precargado: objetivo de fotos aptas disponibles para cada tipo de video.
POOL_TARGET_IMAGES=100
POOL_LOW_STOCK_THRESHOLD=12
# Maximo de cuentas que /download_pool consulta en Instagram por ejecucion.
# Las cuentas ya cacheadas/locales se revisan primero. 0 = sin limite.
POOL_REFILL_MAX_FRESH_ACCOUNTS=8
ACCOUNT_COOLDOWN_DAYS=30

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
SLIDE_SECONDS=3.8
TRANSITION_SECONDS=0.35

# Telegram bots tienen un límite real de 50 MB. Si el render supera este valor
# se vuelve a codificar con un CRF más alto antes de enviarlo.
MAX_VIDEO_SIZE_MB=48

# Cuántas firmas de guion guardar por (tipo, idioma) antes de empezar a
# rotarlas para que el dedup no degenere.
HISTORY_MAX_PER_BUCKET=200

# Reintentos y backoff exponencial para descargas individuales del CDN de IG.
DOWNLOAD_RETRIES=3
DOWNLOAD_BACKOFF_SECONDS=1.5

# Borrar carpetas de output más antiguas que esto. 0 desactiva la limpieza.
OUTPUT_RETENTION_DAYS=7

# Cuánto tiempo reutilizar las imágenes ya descargadas de una cuenta sin
# volver a pegarle a Instagram. 0 = permanente: descargar una vez y elegir
# siempre desde data/downloads/<cuenta>.
ACCOUNT_CACHE_TTL_HOURS=0

# Máximo de cuentas a probar por /create antes de responder con error.
# Sube este valor si prefieres esperar más tiempo buscando una cuenta viable.
# 0 = usar el límite rápido por defecto del bot.
ACCOUNT_PICK_ATTEMPTS=24

# Carrusel IA tipo 4. Por defecto usa fal.ai Flux Kontext Pro para convertir
# una foto de referencia en una historia estilo comic/dibujo. El bot pone los
# textos exactos despues, fuera de la IA.
IMAGE_PROVIDER=fal
FAL_KEY=
FAL_MODEL=fal-ai/flux-pro/kontext
FAL_IMAGE_ASPECT_RATIO=9:16
FAL_OUTPUT_FORMAT=png
FAL_SAFETY_TOLERANCE=2
FAL_GUIDANCE_SCALE=3.5
FAL_POLL_INTERVAL_SECONDS=2
FAL_REQUEST_TIMEOUT_SECONDS=240

# Fallback opcional premium: pon IMAGE_PROVIDER=openai si quieres comparar.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high
OPENAI_REQUEST_TIMEOUT_SECONDS=180

# Videos plantilla desde Cloudflare R2. El bot lista videos en R2, descarga uno
# temporalmente, le añade textos/iconos y genera un MP4 final sin audio.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opcional si prefieres pasar el endpoint completo:
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Prefijo/carpeta por defecto dentro del bucket, por ejemplo videos/plantilla/
R2_INPUT_PREFIX=
# Prefijo/carpeta por defecto para la web de subida de imagenes.
R2_IMAGE_PREFIX=videos/imagenes

# Web interna para subir imagenes a R2. Si la activas junto al bot, se sirve en
# UPLOAD_SITE_HOST:UPLOAD_SITE_PORT dentro del contenedor.
UPLOAD_SITE_ENABLED=true
UPLOAD_SITE_HOST=0.0.0.0
UPLOAD_SITE_PORT=8000
UPLOAD_SITE_USERNAME=admin
UPLOAD_SITE_PASSWORD=pon_una_password
UPLOAD_SITE_MAX_IMAGE_MB=20
